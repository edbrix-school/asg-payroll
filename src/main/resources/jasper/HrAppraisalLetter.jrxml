					<font fontName="Arial" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["After thorough review of your performance, the management has decided to promote you as <style isBold=\"true\" isUnderline=\"true\" >  \"" + $F{NEW_DESIGNATION} + "\" </style> and pleased to revise your salary by <style isBold=\"true\" > BD " + $F{NET_INCREMENT} + "/- </style>  from "  +  $F{PERIOD_FROM} +  " and the revised structure is given below :- "]]></textFieldExpression>
			</textField>
