	<subDataset name="PaytypeDetails" uuid="f58b4cdc-714c-49a3-9cdc-30dd746ac1c2">
		<parameter name="EMPLOYEE_POID" class="java.lang.String">
			<defaultValueExpression><![CDATA[10]]></defaultValueExpression>
		</parameter>
		<parameter name="DOC_KEY_POID" class="java.lang.String">
			<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT PAY_TYPE, PAY_AMOUNT
FROM
      (SELECT DTL.TRANSACTION_POID, DTL.EMPLOYEE_POID, DTL.NEW_BASIC_SALARY, DTL.NEW_FA_ALW, DTL.NEW_TA_ALW, DTL.NEW_HRA_ALW, DTL.NEW_FIXOT_ALW
      FROM  HR_APPRAISAL_DTL DTL
      ) TEMP UNPIVOT (PAY_AMOUNT FOR PAY_TYPE IN (NEW_BASIC_SALARY AS 'Basic Salary with the Social Allowance' , NEW_FA_ALW AS 'Fixed Allowance',
      NEW_TA_ALW AS 'Transport', NEW_HRA_ALW AS 'HRA', NEW_FIXOT_ALW as 'Fixed OT'))
WHERE EMPLOYEE_POID = $P{EMPLOYEE_POID}
AND TRANSACTION_POID = $P{DOC_KEY_POID}
AND TRANSACTION_POID>1
AND NVL(PAY_AMOUNT,0) <> 0]]>
		</queryString>
		<field name="PAY_TYPE" class="java.lang.String"/>
		<field name="PAY_AMOUNT" class="java.math.BigDecimal"/>
		<variable name="Gross" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{PAY_AMOUNT}]]></variableExpression>
			<initialValueExpression><![CDATA[0]]></initialValueExpression>
		</variable>
	</subDataset>
	<parameter name="LOGIN_GROUP_POID" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_COMP_POID" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_USER_POID" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[82]]></defaultValueExpression>
	</parameter>
	<parameter name="DOC_ID" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["800-103"]]></defaultValueExpression>
	</parameter>
	<parameter name="DOC_KEY_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["\\\\10.100.100.3\\erp_reports\\Reports\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="EMPLOYEE_POID" class="java.lang.String"/>
	<parameter name="P_RPT_SELECTED_VALUES_LIST" class="java.lang.String"/>
	<parameter name="SUB_HEADER" class="net.sf.jasperreports.engine.JasperReport"/>
	<queryString>
		<![CDATA[SELECT dept.dept_code,DM2.DESIGNATION_NAME,
NVL(GCM.COMPANY_POID,1) as COMPANY_POID, HDR.TRANSACTION_DATE, HDR.DOC_REF, TO_CHAR(HDR.PERIOD_FROM,'DD-MON-YYYY') PERIOD_FROM, DTL.TRANSACTION_POID,DTL.DET_ROW_ID,DTL.JOIN_DATE,
      TO_CHAR(EM.EMPLOYEE_POID) EMPLOYEE_POID, EM.EMPLOYEE_CODE, CASE WHEN GENDER = 'MALE' THEN 'Mr.' ELSE 'Ms.' END  || EMPLOYEE_NAME || ' ' || EMPLOYEE_NAME2 AS EMPLOYEE_NAME, EM.NATIONALITY_POID,
      GET_CR_NAME(EM.CR_POID)EMP_REG_COMP, EM.ACTIVE, EM.EMP_GL_POID, GET_DESIGNATION_NAME(DTL.DESIGNATION_POID) CUR_DESIGNATION,
      DTL.CUR_NO_OF_TICKETS,DTL.CUR_AIR_ENTITLE, DTL.CUR_BONUS, DTL.CUR_INCREMENT, DTL.CUR_BASIC_SALARY,DTL.CUR_FA_ALW,DTL.CUR_TA_ALW,DTL.CUR_HRA_ALW
      ,DTL.CUR_FIXOT_ALW,DTL.CUR_SPL_ALW, DTL.CUR_OTH_ALW, DTL.CUR_AVGOT,DTL.CUR_GROSS_PAY, DTL.NEW_AIR_ENTITLE,
      DTL.NEW_INCREMENT_PER,DTL.NEW_BASIC_SALARY, DTL.NEW_FA_ALW,DTL.NEW_TA_ALW,DTL.NEW_HRA_ALW, DTL.NEW_FIXOT_ALW,DTL.NEW_SPL_ALW,DTL.NEW_OTH_ALW,
      DTL.NEW_AVGOT,DTL.NEW_GROSS_PAY, NVL(NEW_BONUS,0) NEW_BONUS, CUR_TICKET_PERIOD, CUR_NO_OF_TICKETS, NEW_TICKET_PERIOD, DTL.NEW_NO_OF_TICKETS,
      GET_DESIGNATION_NAME(DTL.NEW_DESIGNATION_POID) NEW_DESIGNATION,
	FN_AMOUNT_IN_WORDS_COMMON(NVL(NEW_BONUS,0), 'BHD') AMOUNT_IN_WORDS,
      CUR_NO_OF_TICKETS || ' ticket(s) in every ' || CUR_TICKET_PERIOD || ' year' AS CUR_TICKET_ENTITLEMENT,
      NVL(NEW_NO_OF_TICKETS,CUR_NO_OF_TICKETS) || ' ticket(s) in every ' || NVL(NEW_TICKET_PERIOD,CUR_TICKET_PERIOD) || ' year' as NEW_TICKET_ENTITLEMENT
	, NVL(DTL.NET_INCREMENT,0) as NET_INCREMENT,TRIM(decode(mod(new_bonus,1),'0',to_char(new_bonus,'999,999')||' /-',to_char(new_bonus,'999,999.000')))  display_new_bonus
FROM  HR_APPRAISAL_DTL DTL
INNER JOIN HR_EMPLOYEE_MASTER EM ON EM.EMPLOYEE_POID = DTL.EMPLOYEE_POID
LEFT JOIN HR_DEPARTMENT_MASTER DEPT ON EM.DEPARTMENT_POID = DEPT.DEPT_POID
LEFT JOIN HR_DESIGNATION_MASTER DM2 ON DTL.DESIGNATION_POID = DM2.DESIG_POID
INNER JOIN HR_APPRAISAL_HDR HDR  ON HDR.TRANSACTION_POID = DTL.TRANSACTION_POID
LEFT JOIN ADMIN_CR_MASTER CR        ON EM.CR_POID          = CR.CR_POID
LEFT JOIN GLOBAL_COMPANY_MASTER GCM ON CR.COMPANY_POID     = GCM.COMPANY_POID
WHERE DTL.TRANSACTION_POID>1 AND (DTL.TRANSACTION_POID                           =  $P{DOC_KEY_POID}
OR
(DTL.TRANSACTION_POID||EM.department_poid) IN (SELECT * FROM TABLE(FUNC_GLOB_SPLIT_STRING($P{P_RPT_SELECTED_VALUES_LIST},','))))
 AND DTL.EMPLOYEE_POID = NVL($P{EMPLOYEE_POID},DTL.EMPLOYEE_POID)
AND ( NVL(DTL.NET_INCREMENT,0) <> 0 OR NVL(NEW_BONUS,0) <> 0 )
ORDER BY dept.dept_code , TO_NUMBER(EM.EMPLOYEE_CODE)]]>
	</queryString>
	<field name="DEPT_CODE" class="java.lang.String"/>
	<field name="DESIGNATION_NAME" class="java.lang.String"/>
	<field name="COMPANY_POID" class="java.math.BigDecimal"/>
	<field name="TRANSACTION_DATE" class="java.sql.Timestamp"/>
	<field name="DOC_REF" class="java.lang.String"/>
	<field name="PERIOD_FROM" class="java.lang.String"/>
	<field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
