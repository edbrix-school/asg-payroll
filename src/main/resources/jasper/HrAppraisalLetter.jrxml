	<field name="CUR_FIXOT_ALW" class="java.math.BigDecimal"/>
	<field name="CUR_SPL_ALW" class="java.math.BigDecimal"/>
	<field name="CUR_OTH_ALW" class="java.math.BigDecimal"/>
	<field name="CUR_AVGOT" class="java.math.BigDecimal"/>
	<field name="CUR_GROSS_PAY" class="java.math.BigDecimal"/>
	<field name="NEW_AIR_ENTITLE" class="java.lang.String"/>
	<field name="NEW_INCREMENT_PER" class="java.math.BigDecimal"/>
	<field name="NEW_BASIC_SALARY" class="java.math.BigDecimal"/>
	<field name="NEW_FA_ALW" class="java.math.BigDecimal"/>
	<field name="NEW_TA_ALW" class="java.math.BigDecimal"/>
	<field name="NEW_HRA_ALW" class="java.math.BigDecimal"/>
