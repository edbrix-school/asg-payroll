				<textFieldExpression><![CDATA[($F{NET_INCREMENT} > "0".toInteger() ?"In addition to this as" : "As") + " an appreciation of your hard work and dedication, we are pleased to grant you a <style isBold=\"true\" isUnderline=\"true\"> onetime exgratia amount of BD. " + $F{DISPLAY_NEW_BONUS} + " </style> (BD " +  $F{AMOUNT_IN_WORDS} + " )"]]></textFieldExpression>
