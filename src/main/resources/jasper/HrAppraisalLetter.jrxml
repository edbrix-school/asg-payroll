		<band height="39">
			<printWhenExpression><![CDATA[(!$F{CUR_TICKET_ENTITLEMENT}.equals($F{NEW_TICKET_ENTITLEMENT}))]]></printWhenExpression>
			<textField>
				<reportElement x="1" y="0" width="502" height="35" uuid="afa351e0-99bf-42fb-956c-dc5c150f9be5"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle" markup="styled">
					<font fontName="Arial" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["Also your air ticket entitlement has been revised as <style isBold=\"true\" isUnderline=\"true\" >  \"" + $F{NEW_TICKET_ENTITLEMENT} + "\" </style>  "]]></textFieldExpression>
			</textField>
		</band>
		<band height="147">
			<staticText>
				<reportElement x="1" y="5" width="502" height="134" uuid="609d2758-7ee9-40b1-b807-bce08fca19a5"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial" size="12" isItalic="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[At this happy moment, we would like to draw your attention to the fact that even while we are going through one of the worst market conditions, the management has rewarded you for your good work and contribution. We are confident that you will do much better and produce better results going forward.

This letter is highly confidential. Any voluntary or involuntary disclosure will result in strict disciplinary action and the given benefits may be revoked.

Wishing you all the best.
]]></text>
			</staticText>
		</band>
	</detail>
