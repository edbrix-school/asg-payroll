	</parameter>
	<parameter name="P_RPT_SELECTED_VALUES_LIST" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT CR.COMPANY_POID, nvl(DIVISION_NAME,CM.COMPANY_NAME) COMPANY_NAME, CMD.COMPANY_DIV_ADDRESS, EMP.EMPLOYEE_POID, EMP.EMPLOYEE_CODE, EMP.EMPLOYEE_NAME || ' ' || EMP.EMPLOYEE_NAME2 AS EMPLOYEE_NAME , TO_CHAR(NVL(EMP.CONTRACT_START,
      EMP.JOIN_DATE),'DD-MON-YYYY') AS CONTRACT_START, CONTRACT_END, GET_COMPANY_NAME(EMP.COMPANY_POID) COMPANY, DEP.DEPT_NAME,
      DES.DESIGNATION_NAME, EMP.DISPLAY_NAME, EMP.PRESENT_ADDRESS, NVL(EMP.PERMANENT_ADDRESS,' ') PERMANENT_ADDRESS, EMP.POSTAL_ADDRESS, EMP.PASSPORT_NO,
      EMP.CPR_NO,EMP.NATIONALITY_POID, EMP.PRESENT_ADDRESS,CR.CR_NUMBER,CR.CR_NAME,NL.NATIONALITY_DESCRIPTION, SM.BASIC_SALARY, SM.FXALW, SM.TRNSP, SM.HRAALW, SM.FXOT,
       EMP.TICKET_PERIOD, TO_NUMBER(EMP.NO_OF_TICKETS) NO_OF_TICKETS,
	 CASE WHEN NVL(EMP.NO_OF_TICKETS,0) = 0 THEN ''
		WHEN EMP.NO_OF_TICKETS = 1 THEN 'Second party' ELSE 'Second party, wife and maximum two children' END TICKET_CLAUSE,
	CASE WHEN EMP.TICKET_PERIOD = 1 THEN 'One (1) Year' WHEN EMP.TICKET_PERIOD = 2 THEN 'Two (2) Years' END TICKER_YEARS,
CASE
WHEN TO_DATE(NVL(SM.LAST_INCREMENT_DATE,NVL(EMP.CONTRACT_START,EMP.JOIN_DATE))) = TO_DATE(NVL(EMP.CONTRACT_START,EMP.JOIN_DATE)) THEN
' '
ELSE
' wef:'||TO_CHAR(SM.LAST_INCREMENT_DATE,'DD-MON-YYYY')
END LAST_INCREMENT_DATE,nvl(SM.BASIC_SALARY,0)+nvl(SM.FXALW,0)+nvl(SM.TRNSP,0)+nvl(SM.HRAALW,0)+nvl(SM.FXOT,0) GROSS_PAYABLE,COMPANY_DIV_POID
FROM  HR_EMPLOYEE_MASTER EMP
LEFT JOIN HR_DEPARTMENT_MASTER DEP     ON EMP.DEPARTMENT_POID =DEP.DEPT_POID
LEFT JOIN HR_DESIGNATION_MASTER DES    ON EMP.DESIGNATION_POID=DES.DESIG_POID
LEFT JOIN ADMIN_CR_MASTER CR           ON CR.CR_POID          =EMP.CR_POID
LEFT JOIN HR_NATIONALITY_MASTER NL     ON NL.NATION_POID      =EMP.NATIONALITY_POID
LEFT JOIN VIEW_HR_EMP_SALARY_MASTER SM ON EMP.EMPLOYEE_POID   = SM.EMPLOYEE_POID
LEFT JOIN GLOBAL_COMPANY_MASTER CM ON CR.COMPANY_POID   = CM.COMPANY_POID
INNER JOIN GLOBAL_COMPANY_MASTER_DIV_DTL CMD ON CM.COMPANY_POID = CMD.COMPANY_POID AND CMD.DIV_POID =nvl(COMPANY_DIV_POID, '1')
WHERE EMP.EMPLOYEE_POID >1 AND
 (EMP.EMPLOYEE_POID  = $P{DOC_KEY_POID}
   OR EMP.EMPLOYEE_POID    IN (SELECT * FROM TABLE(FUNC_GLOB_SPLIT_STRING($P{P_RPT_SELECTED_VALUES_LIST},',')) ))
ORDER BY EMP.EMPLOYEE_POID ]]>
	</queryString>
