		<band height="76">
			<staticText>
				<reportElement x="6" y="17" width="484" height="20" uuid="e8f4e8e5-bd1e-4244-be8c-2d320d97daae"/>
				<textElement>
					<font fontName="Arial" size="12" isUnderline="true"/>
				</textElement>
				<text><![CDATA[The second party’s Eligibility for Visa and Air Tickets :]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement x="6" y="37" width="524" height="29" uuid="c3ce25e8-b137-483e-bdd8-ce29e433bac7"/>
				<textElement>
					<font fontName="Arial"/>
				</textElement>
				<textFieldExpression><![CDATA["a. A return economy class Air Passage to the " + $F{TICKET_CLAUSE} + ", to the closest international airport in the country of domicile after completion of " + $F{TICKER_YEARS}   + " service with the company. "]]></textFieldExpression>
			</textField>
		</band>
		<band height="22">
			<printWhenExpression><![CDATA[$F{NO_OF_TICKETS} > "1".toInteger()]]></printWhenExpression>
			<textField isStretchWithOverflow="true">
				<reportElement x="6" y="3" width="524" height="16" uuid="70ccb74f-bafc-4c47-90b1-f31036fa11e5"/>
				<textElement>
					<font fontName="Arial"/>
				</textElement>
				<textFieldExpression><![CDATA["b. Family Visa will be provided to the Second Party’s wife & maximum two children." + $F{NO_OF_TICKETS}]]></textFieldExpression>
			</textField>
		</band>
		<band height="219">
			<staticText>
				<reportElement x="6" y="70" width="275" height="12" uuid="3776f09a-e25d-44ba-8354-be484fdf128a"/>
				<textElement>
					<font fontName="Arial" size="10"/>
				</textElement>
				<text><![CDATA[For the First Party]]></text>
			</staticText>
			<staticText>
				<reportElement x="297" y="149" width="232" height="46" uuid="fbd80f99-7386-404a-88c9-f63eda941779">
					<printWhenExpression><![CDATA[false]]></printWhenExpression>
				</reportElement>
				<textElement>
					<font fontName="Arial" size="10"/>
				</textElement>
				<text><![CDATA[Signature: ………………………………..

Date: ……………………………………….
]]></text>
			</staticText>
			<staticText>
				<reportElement x="6" y="3" width="524" height="48" uuid="bdb76eec-721e-457e-80b0-4acd69b4b017"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial" size="10"/>
				</textElement>
				<text><![CDATA[Accordingly, the parties agree that this Annex No.1 shall constitute the current financial contract between the parties while retaining all the original contract items, as the Employee has voluntarily agreed to enter into this addendum without any duress and confirm his/her approval by his/her signature herein .]]></text>
			</staticText>
