<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="EmployeeSalaryCertificate" language="groovy" pageWidth="612" pageHeight="792" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="5e997071-2028-4b85-8571-5f873696e15a">
	<property name="ireport.zoom" value="1.4641000000000006"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="LOGIN_GROUP_POID" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_COMP_POID" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_USER_POID" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[82]]></defaultValueExpression>
	</parameter>
	<parameter name="DOC_ID" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["800-103"]]></defaultValueExpression>
	</parameter>
	<parameter name="DOC_KEY_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[382]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["\\\\shippingbahrain.com\\data\\ERP_REPORTS\\Reports\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT EMP.EMPLOYEE_POID,  DDM.DEPT_NAME, EMP.EMPLOYEE_CODE, DESIGNATION_NAME as DESIGNATION,
	EMP.EMPLOYEE_NAME || ' ' || EMP.EMPLOYEE_NAME2 as EMPLOYEE_NAME, EMP.JOIN_DATE, EMP.CPR_NO, SM.BASIC_SALARY, EMP.PASSPORT_NO,
	SM.FIXED_ALLOWANCE, SM.FIXED_OT, SM.TRANSPORT_ALLOWANCE, SM.TEL_ALLOWANCE, SM.HRA_ALLOWANCE,
	NVL(SM.BASIC_SALARY,0) + NVL(SM.FIXED_ALLOWANCE,0) + NVL(SM.FIXED_OT,0) + NVL( SM.TRANSPORT_ALLOWANCE,0) + NVL(SM.HRA_ALLOWANCE,0) AS GROSS_PAY,
	NM.NATIONALITY_DESCRIPTION as NATIONALITY
FROM  HR_EMPLOYEE_MASTER EMP
INNER JOIN
	(SELECT SM.EMPLOYEE_POID, SM.BASIC_SALARY, SM.BANK_POID, SM.IBAN_ACCOUNT_NO, SM.PAYMENT_METHOD, SM.REGISTERED_SALARY,
		SUM(NVL(FXALW.AMOUNT,0)) AS FIXED_ALLOWANCE , SUM(NVL(HRAALW.AMOUNT,0)) AS HRA_ALLOWANCE ,
		SUM(NVL(TRNSP.AMOUNT,0)) AS TRANSPORT_ALLOWANCE, SUM(NVL(TELALW.AMOUNT,0)) AS TEL_ALLOWANCE, SUM(NVL(FXOT.AMOUNT,0)) AS FIXED_OT
	FROM  HR_EMPLOYEE_SALARY_MASTER SM
	LEFT JOIN HR_EMPLOYEE_SALARY_ALW_DTL FXALW ON FXALW.SALARY_POID                      = SM.SALARY_POID AND FXALW.ALLOWANCE_DEDUCTION_POID IN
		(SELECT ALLOWACE_DEDUCTION_POID FROM  HR_ALLOWANCE_DEDUCTION_MASTER WHERE CODE = 'FXALW'
		)
	LEFT JOIN HR_EMPLOYEE_SALARY_ALW_DTL FXOT ON FXOT.SALARY_POID                      = SM.SALARY_POID AND FXOT.ALLOWANCE_DEDUCTION_POID IN
		(SELECT ALLOWACE_DEDUCTION_POID FROM  HR_ALLOWANCE_DEDUCTION_MASTER WHERE CODE = 'FXOT'
		)
	LEFT JOIN HR_EMPLOYEE_SALARY_ALW_DTL HRAALW ON HRAALW.SALARY_POID                    = SM.SALARY_POID AND HRAALW.ALLOWANCE_DEDUCTION_POID IN
		(SELECT ALLOWACE_DEDUCTION_POID FROM  HR_ALLOWANCE_DEDUCTION_MASTER WHERE CODE = 'HRAALW'
		)
	LEFT JOIN HR_EMPLOYEE_SALARY_ALW_DTL TRNSP ON TRNSP.SALARY_POID                      = SM.SALARY_POID AND TRNSP.ALLOWANCE_DEDUCTION_POID IN
		(SELECT ALLOWACE_DEDUCTION_POID FROM  HR_ALLOWANCE_DEDUCTION_MASTER WHERE CODE = 'TRNSP'
		)
	LEFT JOIN HR_EMPLOYEE_SALARY_ALW_DTL TELALW ON TELALW.SALARY_POID                      = SM.SALARY_POID AND TELALW.ALLOWANCE_DEDUCTION_POID IN
		(SELECT ALLOWACE_DEDUCTION_POID FROM  HR_ALLOWANCE_DEDUCTION_MASTER WHERE CODE = 'TELALW'
		)
	GROUP BY SM.EMPLOYEE_POID, SM.BANK_POID, SM.IBAN_ACCOUNT_NO, SM.PAYMENT_METHOD, SM.BASIC_SALARY,  SM.REGISTERED_SALARY
	) SM ON EMP.EMPLOYEE_POID = SM.EMPLOYEE_POID
LEFT JOIN HR_DESIGNATION_MASTER DM ON EMP.DESIGNATION_POID = DM.DESIG_POID
LEFT JOIN HR_NATIONALITY_MASTER NM ON EMP.NATIONALITY_POID = NM.NATION_POID
LEFT JOIN HR_DEPARTMENT_MASTER DDM ON EMP.DEPARTMENT_POID   = DDM.DEPT_POID
LEFT JOIN GLOBAL_CUSTOMER_BANK_MASTER CBM ON CBM.BANK_POID   = SM.BANK_POID
WHERE NVL(EMP.ACTIVE,'Y') = 'Y'
AND SM.EMPLOYEE_POID = $P{DOC_KEY_POID}
ORDER BY DDM.DEPT_NAME, TO_NUMBER(EMP.EMPLOYEE_CODE)]]>
	</queryString>
	<field name="EMPLOYEE_POID" class="java.math.BigDecimal"/>
	<field name="DEPT_NAME" class="java.lang.String"/>
	<field name="EMPLOYEE_CODE" class="java.lang.String"/>
	<field name="DESIGNATION" class="java.lang.String"/>
	<field name="EMPLOYEE_NAME" class="java.lang.String"/>
	<field name="JOIN_DATE" class="java.sql.Timestamp"/>
	<field name="CPR_NO" class="java.lang.String"/>
	<field name="BASIC_SALARY" class="java.math.BigDecimal"/>
	<field name="PASSPORT_NO" class="java.lang.String"/>
	<field name="FIXED_ALLOWANCE" class="java.math.BigDecimal"/>
	<field name="FIXED_OT" class="java.math.BigDecimal"/>
	<field name="TRANSPORT_ALLOWANCE" class="java.math.BigDecimal"/>
	<field name="TEL_ALLOWANCE" class="java.math.BigDecimal"/>
	<field name="HRA_ALLOWANCE" class="java.math.BigDecimal"/>
	<field name="GROSS_PAY" class="java.math.BigDecimal"/>
	<field name="NATIONALITY" class="java.lang.String"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="134" splitType="Stretch"/>
	</title>
