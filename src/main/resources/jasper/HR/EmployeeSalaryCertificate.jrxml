	<detail>
		<band height="231" splitType="Stretch">
			<textField>
				<reportElement x="0" y="0" width="555" height="125" uuid="da11889b-92c4-4842-902f-b33591a57ca7"/>
				<textElement textAlignment="Justified"/>
				<textFieldExpression><![CDATA[
"This is to certify that  <style isBold=\"true\" > " + $F{EMPLOYEE_NAME} + " </style>," + $F{NATIONALITY} + " National, holder of  Passport No # " + $F{PASSPORT_NO} + " and CPR # " + $F{CPR_NO} + " has been working as a " + $F{DESIGNATION} + " in our establishment from " + $F{JOIN_DATE}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<pageFooter>
