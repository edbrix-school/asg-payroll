	<queryString>
		<![CDATA[SELECT EM.EMPLOYEE_CODE,EM.EMPLOYEE_NAME,SM.IBAN_ACCOUNT_NO as ACCOUNT_NO, SH.BASIC_SALARY, SH.TRANSACTION_POID, SH.TRANSACTION_DATE, SH.DOC_REF, SH.EMPLOYEE_POID,
      SH.SETTLEMENT_TYPE, SH.LEAVE_TYPE, SH.HOME_COUNTRY_PHONE, SH.LEAVE_START_DATE, SH.LEAVE_END_DATE, SH.REJOIN_DATE, SH.LEAVE_DAYS,
      SH.ELIGIBLE_LEAVE_DAYS, SH.BALANCE_LEAVE_DAYS, SH.LEAVE_SALARY, SH.TICKET_ELIGIBLITY, SH.TICKET_ISSUE_TYPE,
	NVL(SH.TICKET_ISSUED_COUNT,0) as TICKET_ISSUED_COUNT, NVL(SH.TICKET_ENCASHMENT,0) as TICKET_ENCASHMENT,
	SH.AIR_SECTOR_POID, SH.BASIC_SALARY,
      NVL(SH.WORKED_DAYS,0) + NVL(SH.WORKED_DAYS2,0) as WORKED_DAYS,
      NVL(SH.BASIC_SALARY_PAYABLE,0) + NVL(SH.BASIC_SALARY_PAYABLE2,0) as BASIC_SALARY_PAYABLE,
      NVL(SH.FIXED_ALLOWANCE,0) + NVL(SH.FIXED_ALLOWANCE2,0) as FIXED_ALLOWANCE,
	NVL(SH.FIXED_OT,0) + NVL(SH.FIXED_OT2,0) as FIXED_OT,
      NVL(SH.HRA_ALLOWANCE,0) + NVL(SH.HRA_ALLOWANCE2,0) as HRA_ALLOWANCE,
      NVL(SH.TRANSPORT_ALLOWANCE,0) + NVL(SH.TRANSPORT_ALLOWANCE2,0) as TRANSPORT_ALLOWANCE,
      NVL(SH.COMMUNICATION_ALLOWANCE,0) + NVL(SH.COMMUNICATION_ALLOWANCE2,0) as COMMUNICATION_ALLOWANCE,
      NVL(SH.SPECIAL_ALLOWANCE,0) + NVL(SH.SPECIAL_ALLOWANCE2,0) as SPECIAL_ALLOWANCE,
      NVL(SH.TRAVEL_ALLOWANCE,0) + NVL(SH.TRAVEL_ALLOWANCE2,0) as TRAVEL_ALLOWANCE,
      NVL(SH.GROSS_SALARY,0) + NVL(SH.GROSS_SALARY2,0) as GROSS_SALARY,
      NVL(SH.GOSI_DEDUCTION,0) + NVL(SH.GOSI_DEDUCTION2,0) as GOSI_DEDUCTION,
      (NVL(SH.LOAN_DEDUCTION,0) + NVL(SH.LOAN_DEDUCTION2,0)) * -1 as LOAN_DEDUCTION,
      NVL(SH.NET_SALARY,0) + NVL(SH.NET_SALARY2,0) as NET_SALARY,
      NVL(SH.WORKED_DAYS,0) + NVL(SH.WORKED_DAYS2,0) as WORKED_DAYS,
      SH.ABSENT_DAYS, SH.ABSENT_AMOUNT,
      SH.ARREARS, SH.PHONE_DEDUCTION, SH.MEDICAL_INSURANCE, SH.RECURRING_DEDUCTION, SH.OTHER_DEDUCTIONS,
      SH.OTHER_DED_GL, SH.DATE_OF_LEAVING, SH.REASON_FOR_LEAVING, EM.JOIN_DATE,
      SH.TOTAL_YEARS_SERVICE, SH.TOTAL_INDEMNITY_DAYS, SH.INDEMNITY_IN_THREE_YR, SH.INDEMNITY_AFTER_THREE_YR, SH.TOTAL_INDEMNITY_AMOUNT,
	NVL(SH.EXGRATIA,0) EXGRATIA, SH.OTHER_ALLOWANCE, SH.OTHER_ALLOWANCE2, SH.OTHER_DEDUCTIONS,
      SH.PREV_INDEMNITY_DATE, SH.TOTAL_SETTLEMENT_AMT, SH.PAYMENT_METHOD, SH.SETTLEMENT_STATUS, SH.LAST_WORKING_DATE, SH.GOSI_FROM_DATE,
      SH.GOSI_TO_DATE,  SH.MEDICAL_INSURANCE2,
      SH.OTHER_ALLOWANCE_DETAILS,  SH.OTHER_ALLOWANCE_DETAILS2,SH.OTHER_DEDUCTIONS_DETAILS, SH.PAYROLL1_DATE,
      SH.PAYROLL2_DATE, SH.LAST_LEAVE_DETAILS, SH.WORK_DAYS_FROM_LAST_LEAVE,
      -1 * SH.PAID_LEAVES_TAKEN PAID_LEAVES_TAKEN, SH.BASIC_FIX_ALW, SH.BASIC_FIX_OT, SH.LAST_REJOIN_DATE,
      SH.BASIC_ELIGIBLE_LEAVE_DAYS, SH.BASIC_SAL_PER_DAY, SH.GROSS_SAL_PER_DAY, SH.BASIC_HRA, SH.BASIC_TRANSPORT,
	FN_AMOUNT_IN_WORDS_COMMON(TOTAL_SETTLEMENT_AMT, 'BHD') AMOUNT_IN_WORDS,
 '(From ' || TO_CHAR(NVL(SH.PREV_INDEMNITY_DATE, SH.JOIN_DATE)) || ' to ' || TO_CHAR(LEAVE_START_DATE -1) || ' )' as INDEMNITY_PERIOD,
 '(From ' || TO_CHAR(NVL(SH.LAST_REJOIN_DATE, SH.JOIN_DATE)) || ' to ' ||  TO_CHAR(LEAVE_START_DATE -1) || ' )' as LEAVE_SALARY_PERIOD,
 SH.CREATED_BY , NVL(SH.ROUND_OFF,0) as ROUND_OFF,
 INDEMNITY_FIRST_THREE_YR_DAYS, INDEMNITY_AFTER_THREE_YR_DAYS, INDEMNITY_SERVICE_DAYS, LATE_DEDUCTION_AMT, SH.REMARKS,
 -1* NVL(SH.EXCESS_VISA_CHARGES,0) as EXCESS_VISA_CHARGES,
INDEMNITY_ELIGIBLE_DAYS, SIO_SHARE_INDEMNITY, INDMNTY_MNTHS_COMPANY, INDMNTY_MNTHS_SIO,
CASE WHEN TO_CHAR(TRANSACTION_DATE,'RRRRMM')<='202401' THEN 'N'  ELSE  'Y' END FIX_DESCRIPTION_CHANGED
FROM  HR_LEAVE_SETTLEMENT_HDR SH
INNER JOIN HR_EMPLOYEE_MASTER EM ON SH.EMPLOYEE_POID = EM.EMPLOYEE_POID
INNER JOIN HR_EMPLOYEE_SALARY_MASTER SM ON SH.EMPLOYEE_POID = SM.EMPLOYEE_POID
WHERE SH.TRANSACTION_POID                            =  $P{DOC_KEY_POID}]]>
	</queryString>
