	<queryString>
		<![CDATA[SELECT SH.DOC_REF, SH.TRANSACTION_DATE, EM.EMPLOYEE_CODE, EM.EMPLOYEE_NAME || ' ' || EM.EMPLOYEE_NAME2 AS EMPLOYEE_NAME, DM.DESIGNATION_NAME, EM.JOIN_DATE,
      EM.CPR_NO, EM.PASSPORT_NO, SH.LEAVE_START_DATE, SM.IBAN_ACCOUNT_NO AS ACCOUNT_NO, BM.BANK_DESCRIPTION, SH.CREATED_BY, UM.USER_NAME,
      SH.TOTAL_SETTLEMENT_AMT, BP.CHQ_CARDNO, BP.CHQ_DATE, BM_MAIN.BANK_PREFIX, FN_AMOUNT_IN_WORDS_COMMON(TOTAL_SETTLEMENT_AMT, 'BHD') AMOUNT_IN_WORDS
FROM  HR_LEAVE_SETTLEMENT_HDR SH
INNER JOIN HR_EMPLOYEE_MASTER EM            ON SH.EMPLOYEE_POID    = EM.EMPLOYEE_POID
INNER JOIN HR_DESIGNATION_MASTER DM         ON DM.DESIG_POID       = EM.DESIGNATION_POID
INNER JOIN HR_EMPLOYEE_SALARY_MASTER SM     ON SH.EMPLOYEE_POID    = SM.EMPLOYEE_POID
LEFT JOIN GLOBAL_CUSTOMER_BANK_MASTER BM    ON BM.BANK_POID        = SM.BANK_POID
LEFT JOIN GLOBAL_USERS UM                   ON SH.CREATED_BY       = UM.USER_ID
LEFT JOIN PRODUCTION.GL_BANK_PAYMENT_HDR BP ON BP.TRANSACTION_POID = SH.PAYMENT_DOC_POID AND SH.PAYMENT_DOC_TYPE = 'CHEQUE'
LEFT JOIN PRODUCTION.GL_BANK_MASTER BM_MAIN ON BP.BANK_POID = BM_MAIN.BANK_POID
WHERE SH.TRANSACTION_POID = $P{DOC_KEY_POID}]]>
	</queryString>
