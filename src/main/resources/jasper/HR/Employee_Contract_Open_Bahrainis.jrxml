    </parameter>
    <parameter name="P_RPT_SELECTED_VALUES_LIST" class="java.lang.String"/>
    <parameter name="SUB_HEADER" class="net.sf.jasperreports.engine.JasperReport"/>
    <queryString>
        <![CDATA[SELECT CR.COMPANY_POID, CM.COMPANY_NAME, CMD.COMPANY_DIV_ADDRESS,  EMP.EMPLOYEE_POID, EMP.EMPLOYEE_CODE, EMP.EMPLOYEE_NAME || ' ' || EMP.EMPLOYEE_NAME2 as EMPLOYEE_NAME , TO_CHAR(NVL(EMP.CONTRACT_START, EMP.JOIN_DATE),'DD-MON-YYYY')  as CONTRACT_START, TO_CHAR(NVL(EMP.CONTRACT_END, ''),'DD-MON-YYYY') as CONTRACT_END,
      GET_COMPANY_NAME(EMP.COMPANY_POID) COMPANY, DEP.DEPT_NAME,
      DES.JOB_DESCRIPTION, DES.DESIGNATION_NAME, EMP.DISPLAY_NAME, EMP.PRESENT_ADDRESS, EMP.PERMANENT_ADDRESS, EMP.POSTAL_ADDRESS,
      EMP.PASSPORT_NO,EMP.CPR_NO,EMP.NATIONALITY_POID, EMP.PRESENT_ADDRESS,CR.CR_NUMBER,CR.CR_NAME,NL.NATIONALITY_DESCRIPTION,
      EMP.TICKET_PERIOD, EMP.NO_OF_TICKETS, EMP.JOIN_DATE, NVL(SM.LAST_INCREMENT_DATE, JOIN_DATE) as CONTRACT_DATE
FROM  HR_EMPLOYEE_MASTER EMP
LEFT JOIN HR_DEPARTMENT_MASTER DEP  ON EMP.DEPARTMENT_POID =DEP.DEPT_POID
LEFT JOIN HR_EMPLOYEE_SALARY_MASTER SM  ON SM.EMPLOYEE_POID = EMP.EMPLOYEE_POID
LEFT JOIN HR_DESIGNATION_MASTER DES ON EMP.DESIGNATION_POID=DES.DESIG_POID
LEFT JOIN ADMIN_CR_MASTER CR        ON CR.CR_POID          =EMP.CR_POID
LEFT JOIN HR_NATIONALITY_MASTER NL  ON NL.NATION_POID      =EMP.NATIONALITY_POID
LEFT JOIN GLOBAL_COMPANY_MASTER CM ON CR.COMPANY_POID   = CM.COMPANY_POID
INNER JOIN GLOBAL_COMPANY_MASTER_DIV_DTL CMD ON CM.COMPANY_POID = CMD.COMPANY_POID AND CMD.DIV_POID = 1
WHERE EMP.EMPLOYEE_POID > 1 AND
 (EMP.EMPLOYEE_POID  = $P{DOC_KEY_POID}
   OR EMP.EMPLOYEE_POID    IN (SELECT * FROM TABLE(FUNC_GLOB_SPLIT_STRING($P{P_RPT_SELECTED_VALUES_LIST},',')) ))
ORDER BY EMP.EMPLOYEE_POID]]>
    </queryString>
