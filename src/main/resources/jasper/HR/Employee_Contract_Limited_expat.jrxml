        <defaultValueExpression><![CDATA["000-000"]]></defaultValueExpression>
    </parameter>
    <parameter name="DOC_KEY_POID" class="java.lang.String"/>
    <parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["////10.100.100.3//erp_reports//Reports//"]]></defaultValueExpression>
    </parameter>
    <parameter name="SUB_HEADER" class="net.sf.jasperreports.engine.JasperReport"/>
    <queryString>
        <![CDATA[SELECT EMP.EMPLOYEE_POID, EMP.EMPLOYEE_CODE, EMP.EMPLOYEE_NAME || ' ' || EMP.EMPLOYEE_NAME2 as EMPLOYEE_NAME , TO_CHAR(NVL(EMP.CONTRACT_START, EMP.JOIN_DATE),'DD-MON-YYYY')  as CONTRACT_START, TO_CHAR(NVL(EMP.CONTRACT_END, ''),'DD-MON-YYYY') as CONTRACT_END,
      GET_COMPANY_NAME(EMP.COMPANY_POID) COMPANY, DEP.DEPT_NAME,
      DES.JOB_DESCRIPTION, DES.DESIGNATION_NAME, EMP.DISPLAY_NAME, EMP.PRESENT_ADDRESS, EMP.PERMANENT_ADDRESS, EMP.POSTAL_ADDRESS,
      EMP.PASSPORT_NO,EMP.CPR_NO,EMP.NATIONALITY_POID, EMP.PRESENT_ADDRESS,CR.CR_NUMBER,CR.CR_NAME,NL.NATIONALITY_DESCRIPTION, SM.BASIC_SALARY, FN_AMOUNT_IN_WORDS_COMMON(SM.BASIC_SALARY, 'BHD') NET_SALARY_IN_WORDS,
      EMP.TICKET_PERIOD, EMP.NO_OF_TICKETS
FROM  HR_EMPLOYEE_MASTER EMP
LEFT JOIN HR_DEPARTMENT_MASTER DEP  ON EMP.DEPARTMENT_POID =DEP.DEPT_POID
LEFT JOIN HR_DESIGNATION_MASTER DES ON EMP.DESIGNATION_POID=DES.DESIG_POID
LEFT JOIN ADMIN_CR_MASTER CR        ON CR.CR_POID          =EMP.CR_POID
LEFT JOIN HR_NATIONALITY_MASTER NL  ON NL.NATION_POID      =EMP.NATIONALITY_POID
LEFT JOIN HR_EMPLOYEE_SALARY_MASTER SM ON  EMP.EMPLOYEE_POID = SM.EMPLOYEE_POID
WHERE EMP.EMPLOYEE_POID                                    = $P{DOC_KEY_POID}
ORDER BY EMP.EMPLOYEE_POID]]>
    </queryString>
    <field name="EMPLOYEE_POID" class="java.math.BigDecimal"/>
    <field name="EMPLOYEE_CODE" class="java.lang.String"/>
    <field name="EMPLOYEE_NAME" class="java.lang.String"/>
    <field name="CONTRACT_START" class="java.lang.String"/>
    <field name="CONTRACT_END" class="java.lang.String"/>
    <field name="COMPANY" class="java.lang.String"/>
