				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{HRAALW}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="277" y="105" width="29" height="15" uuid="9c891c3e-e8d9-4b61-b96a-05e18d90c3fb"/>
