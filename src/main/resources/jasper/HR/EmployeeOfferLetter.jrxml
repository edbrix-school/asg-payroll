					<font fontName="Arial" size="8"/>
				</textElement>
				<text><![CDATA[BHD : ]]></text>
			</staticText>
			<textField pattern="#,##0.000;#,##0.000-">
				<reportElement positionType="Float" x="306" y="105" width="53" height="15" uuid="e0183c65-506b-4103-9293-39bdb191cc43"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{BASIC_SALARY}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="45" y="0" width="283" height="18" uuid="39cf281d-0702-441a-b6aa-ef6698c724ec"/>
				<textElement>
					<font size="9"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{EMPLOYEE_NAME}]]></textFieldExpression>
			</textField>
		</band>
		<band height="323" splitType="Stretch">
			<staticText>
				<reportElement positionType="Float" x="4" y="9" width="531" height="12" uuid="696774ff-2102-400d-94ec-db345a3aeb22"/>
				<textElement verticalAlignment="Top">
					<font size="8"/>
				</textElement>
				<text><![CDATA[b)]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="4" y="9" width="531" height="20" uuid="dfe88e9b-a156-41b5-a51e-bda17b3467e4"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="8"/>
					<paragraph leftIndent="16"/>
				</textElement>
				<textFieldExpression><![CDATA["Upon satisfactory completion of three  months probationary period, and after assessment of the Employee’s performance with the approval of the Management the Employee’s position will be confirmed accordingly."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="4" y="35" width="531" height="12" uuid="b957b197-465f-49d4-bf69-14093bb310d4"/>
				<textElement verticalAlignment="Top">
					<font size="8"/>
				</textElement>
				<text><![CDATA[c)]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="4" y="35" width="531" height="20" uuid="1f29f568-5303-431b-861c-1279209709d2"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="8"/>
					<paragraph leftIndent="16"/>
				</textElement>
				<textFieldExpression><![CDATA["A Return Economy class Air Passage will be provided to the Employee, wife and two children to the closest international airport in the country of domicile after completion of two years service with the company."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="4" y="61" width="531" height="12" uuid="fa10232a-8e79-4312-b10e-f0482a94a5f6"/>
				<textElement verticalAlignment="Top">
					<font size="8"/>
				</textElement>
				<text><![CDATA[d)]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="4" y="61" width="531" height="10" uuid="ce5843d7-68f1-4763-a8d2-157413fa7c09"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="8"/>
					<paragraph leftIndent="16"/>
				</textElement>
				<textFieldExpression><![CDATA["Medical Insurance will be provided to the employee as per the medical insurance policy of the company."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="4" y="77" width="531" height="12" uuid="aead3749-f5dd-4770-b3c5-791569c55141"/>
				<textElement verticalAlignment="Top">
					<font size="8"/>
				</textElement>
				<text><![CDATA[e)]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="4" y="77" width="531" height="10" uuid="bb1f80b9-907e-4cab-88ab-ca54e8d5790a"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="8"/>
					<paragraph leftIndent="16"/>
				</textElement>
				<textFieldExpression><![CDATA["Office working hours would be from 0800 hrs. to 1300 hrs. and 1400 hrs. to 17:30 hrs. from Sunday to Thursday."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="4" y="93" width="531" height="12" uuid="af163c9b-aa6e-402b-b98c-699bdffed3e0"/>
				<textElement verticalAlignment="Top">
					<font size="8"/>
				</textElement>
				<text><![CDATA[f)]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="4" y="93" width="531" height="20" uuid="9506c20b-a91e-48a9-87f9-8666de9cb0d4"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="8"/>
					<paragraph leftIndent="16"/>
				</textElement>
				<textFieldExpression><![CDATA["The Employee will be required to carry out all duties related to the field entrusted by the Management and / or any authorized Officer in the organization."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="4" y="119" width="531" height="12" uuid="c1c8f0cf-2de6-492d-afa5-070478b9de27"/>
				<textElement verticalAlignment="Top">
					<font size="8"/>
				</textElement>
				<text><![CDATA[g)]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="4" y="119" width="531" height="20" uuid="2dfea854-55c7-40c6-a4d3-e9d48a7f90f5"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="8"/>
					<paragraph leftIndent="16"/>
				</textElement>
				<textFieldExpression><![CDATA["When and if required, the Employee may have to work after normal hours and on Fridays and holidays depending on the requirements of the company. This is position of continuous responsibility and does not entail payment of extra time or over time."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="4" y="145" width="531" height="12" uuid="17167dfc-9301-448a-8979-957935bae66e"/>
				<textElement verticalAlignment="Top">
					<font size="8"/>
				</textElement>
				<text><![CDATA[h)]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="4" y="145" width="531" height="20" uuid="8b5352d7-8ab2-409d-8a57-08d1b50be940"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="8"/>
					<paragraph leftIndent="16"/>
				</textElement>
				<textFieldExpression><![CDATA["The Employee will be entitled to 30 days Annual Leave on completion of 12 months for every calendar year. All other terms and conditions within the framework of the Kingdom of Bahrain Labour Laws."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="4" y="171" width="531" height="12" uuid="61d1e7fc-be4c-4e9f-8972-5c25a033c841"/>
				<textElement verticalAlignment="Top">
					<font size="8"/>
				</textElement>
				<text><![CDATA[i)]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="4" y="171" width="531" height="10" uuid="c2499092-7220-46c4-811f-0b32caf69653"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="8"/>
					<paragraph leftIndent="16"/>
				</textElement>
				<textFieldExpression><![CDATA["All matters pertaining to the Employee’s appointment and compensation are strictly confidential and it should be treated as such."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="4" y="187" width="531" height="12" uuid="df5c5144-bb31-46cf-b8a3-257714be865d"/>
				<textElement verticalAlignment="Top">
					<font size="8"/>
				</textElement>
				<text><![CDATA[j)]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="4" y="187" width="531" height="40" uuid="1c9ee657-55c1-4f4d-8121-368a19ca8f24"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="8"/>
					<paragraph leftIndent="16"/>
				</textElement>
				<textFieldExpression><![CDATA["During the period of employment, the Employee will be required to abide strictly by the company’s general standards regarding attendance, punctuality and most important discipline. The Employee will work honestly, faithfully, diligently and efficiently for the growth of the company. The employee is expected to maintain utmost secrecy in regard to the affairs of the company and shall keep confidential any information, instruments, documents etc., relating to the company that may come to your professional knowledge."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="4" y="233" width="531" height="12" uuid="919dca84-a192-463d-9065-2238cbd51dce"/>
				<textElement verticalAlignment="Top">
					<font size="8"/>
				</textElement>
				<text><![CDATA[k)]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="4" y="233" width="531" height="20" uuid="24b49386-75f3-4042-91b6-63861baf7d3d"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="8"/>
					<paragraph leftIndent="16"/>
				</textElement>
				<textFieldExpression><![CDATA["In view of employee being found inefficient as per company’s standards requirement, the company reserves the right to terminate your services by giving one calendar month’s notice. In such cases no compensation will be granted for the remaining period of the contract."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="4" y="259" width="531" height="12" uuid="de49abd2-421e-4b84-bbf9-b3c6ccd04533"/>
				<textElement verticalAlignment="Top">
					<font size="8"/>
				</textElement>
				<text><![CDATA[l)]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="4" y="259" width="531" height="30" uuid="1e189125-ab70-4b71-b9bc-68457aa57846"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="8"/>
					<paragraph leftIndent="16"/>
				</textElement>
				<textFieldExpression><![CDATA["In case if the employee is found to be arrogant, indifferent, uncooperative and with a negative attitude towards work, colleagues, customers & or principals in specific cases or in general, the employment will be terminated on the spot and without any notice and or any compensation. In such cases even the normal notice period 1 calendar month will NOT apply and the employee will be asked to vacate the premises and the country at once."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="4" y="295" width="531" height="12" uuid="33e2faa4-3ac0-4d0b-b5a7-3da8ac0d6bd9"/>
				<textElement verticalAlignment="Top">
					<font size="8"/>
				</textElement>
				<text><![CDATA[m)]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="4" y="295" width="531" height="20" uuid="f23ad077-a1bc-47a6-b0f0-4ce501b7f7c8"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="8"/>
					<paragraph leftIndent="16"/>
				</textElement>
				<textFieldExpression><![CDATA["The appointment letter is enclosed in duplicate. The Employee is required to sign and submit a copy of this letter of appointment as a token of your acceptance of the employment terms and conditions."]]></textFieldExpression>
			</textField>
		</band>
	</detail>
