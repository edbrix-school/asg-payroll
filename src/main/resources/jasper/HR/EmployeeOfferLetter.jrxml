	<parameter name="LOGIN_GROUP_POID" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_COMP_POID" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_USER_POID" class="java.lang.String" isForPrompting="false"/>
	<parameter name="DOC_ID" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["000-000"]]></defaultValueExpression>
	</parameter>
	<parameter name="DOC_KEY_POID" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["\\\\10.100.100.159\\ERP_Reports\\Reports\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT EMP.EMPLOYEE_POID, EMP.EMPLOYEE_CODE, EMP.EMPLOYEE_NAME, EMP.CONTRACT_START, DEP.DEPT_NAME, DES.JOB_DESCRIPTION, DES.DESIGNATION_NAME,
      EMP.DISPLAY_NAME, EMP.PERMANENT_ADDRESS, EMP.POSTAL_ADDRESS, SM.BASIC_SALARY, SM.FXALW, SM.TRNSP, SM.HRAALW, SM.FXOT
FROM  HR_EMPLOYEE_MASTER EMP
LEFT JOIN HR_DEPARTMENT_MASTER DEP  ON EMP.DEPARTMENT_POID =DEP.DEPT_POID
LEFT JOIN HR_DESIGNATION_MASTER DES ON EMP.DESIGNATION_POID=DES.DESIG_POID
LEFT JOIN VIEW_HR_EMP_SALARY_MASTER SM ON EMP.EMPLOYEE_POID   = SM.EMPLOYEE_POID
WHERE EMP.EMPLOYEE_POID                                    = $P{DOC_KEY_POID}
ORDER BY EMP.EMPLOYEE_POID ]]>
	</queryString>
	<field name="EMPLOYEE_POID" class="java.math.BigDecimal"/>
	<field name="EMPLOYEE_CODE" class="java.lang.String"/>
	<field name="EMPLOYEE_NAME" class="java.lang.String"/>
