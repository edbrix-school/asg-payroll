					<font fontName="Arial" size="8"/>
				</textElement>
				<text><![CDATA[Basic Salary with the Social Allowance ]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="84" y="121" width="191" height="15" uuid="d8c7ac08-ec49-4623-b1e8-7261e1919086"/>
