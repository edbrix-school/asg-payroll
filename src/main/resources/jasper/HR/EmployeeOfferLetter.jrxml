	<field name="FXALW" class="java.math.BigDecimal"/>
	<field name="TRNSP" class="java.math.BigDecimal"/>
	<field name="HRAALW" class="java.math.BigDecimal"/>
	<field name="FXOT" class="java.math.BigDecimal"/>
