					<font fontName="Arial" size="8"/>
				</textElement>
				<text><![CDATA[Transportation Allowance]]></text>
			</staticText>
			<textField pattern="#,##0.000;#,##0.000-">
				<reportElement positionType="Float" x="306" y="137" width="53" height="15" uuid="05c9630d-c8bc-4b86-b16f-c9b52ceb7833"/>
