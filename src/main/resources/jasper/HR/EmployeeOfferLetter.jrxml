	<detail>
		<band height="185" splitType="Stretch">
			<staticText>
				<reportElement x="20" y="0" width="22" height="18" uuid="99dcde57-ddaa-4152-bdd7-a7c5bfdc6797"/>
				<textElement>
					<font size="9"/>
				</textElement>
				<text><![CDATA[Dear ]]></text>
			</staticText>
			<textField>
				<reportElement x="20" y="19" width="418" height="18" uuid="a20a6fb3-fb99-4eb1-9ee8-dcb6d243ff0c"/>
				<textElement>
					<font size="9"/>
				</textElement>
				<textFieldExpression><![CDATA["Sub : Letter of Appointment for  the Position of "+$F{DESIGNATION_NAME}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="20" y="35" width="521" height="29" uuid="fbb67f46-6d03-4904-8b98-b0a3e01d0d3e"/>
				<textElement>
					<font size="9"/>
				</textElement>
				<textFieldExpression><![CDATA["Reference to your Curriculum Vitae and our subsequent interview with us, we hereby confirm our Offer of Employment for the position of "+$F{DESIGNATION_NAME}+" (Hereinafter referred as ‘Employee’). "]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="20" y="64" width="501" height="38" uuid="98d293e4-bbbc-4bc1-a288-41d4549737bb"/>
				<textElement>
					<font size="8"/>
				</textElement>
				<text><![CDATA[We append below the terms and conditions of Contract of Employment for your perusal and acceptance:

The Employee will be entitled to an All-inclusive monthly emolument of Bahraini Dinars as follows
]]></text>
			</staticText>
			<staticText>
				<reportElement x="4" y="82" width="12" height="20" uuid="b18bf968-2bf8-48e3-9972-de2b68998bde"/>
				<textElement verticalAlignment="Top"/>
				<text><![CDATA[a)]]></text>
			</staticText>
			<textField pattern="#,##0.000;#,##0.000-">
				<reportElement x="306" y="153" width="53" height="15" uuid="9e1a225b-0a51-4771-9fa9-f4e214fd0eac"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="8"/>
