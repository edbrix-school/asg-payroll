	<queryString>
		<![CDATA[SELECT DOC_REF, TRANSACTION_DATE, EM.EMPLOYEE_CODE, EM.EMPLOYEE_NAME || ' ' || EM.EMPLOYEE_NAME2 AS EMPLOYEE_NAME,  DM.DESIGNATION_NAME,
      EM.JOIN_DATE, EM.CPR_NO, EM.PASSPORT_NO, SH.LEAVE_START_DATE, SM.IBAN_ACCOUNT_NO AS ACCOUNT_NO, BM.BANK_DESCRIPTION, SH.CREATED_BY, UM.USER_NAME
FROM  HR_LEAVE_SETTLEMENT_HDR SH
INNER JOIN HR_EMPLOYEE_MASTER EM        ON SH.EMPLOYEE_POID = EM.EMPLOYEE_POID
INNER JOIN HR_DESIGNATION_MASTER DM     ON DM.DESIG_POID    = EM.DESIGNATION_POID
INNER JOIN HR_EMPLOYEE_SALARY_MASTER SM ON SH.EMPLOYEE_POID = SM.EMPLOYEE_POID
LEFT JOIN GLOBAL_CUSTOMER_BANK_MASTER BM ON BM.BANK_POID = SM.BANK_POID
LEFT JOIN GLOBAL_USERS UM ON SH.CREATED_BY = UM.USER_ID
WHERE SH.TRANSACTION_POID = $P{DOC_KEY_POID}]]>
	</queryString>
