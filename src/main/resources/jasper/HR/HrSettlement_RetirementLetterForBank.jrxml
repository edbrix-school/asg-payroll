					<font size="10" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["We would like to inform you that the above referred person is retired from our employement service and her last working day will be " + new SimpleDateFormat("dd-MMM-yyyy").format($F{LEAVE_START_DATE}) + "\n" +
" " + "\n" +
"Her terminal benefits will be transferred to above referred account on or before " + new SimpleDateFormat("dd-MMM-yyyy").format($F{LEAVE_START_DATE}) + "\n" +
" " + "\n" +
" Kindly acknowledge receipt of this letter for our records"]]></textFieldExpression>
			</textField>
