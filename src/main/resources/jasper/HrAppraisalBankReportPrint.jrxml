	<subDataset name="AppraisalData" uuid="f0e63e52-1a9e-42a5-a3b3-ddbe663c2b48">
		<parameter name="TRANSACTION_POID" class="java.lang.String">
			<defaultValueExpression><![CDATA[181]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT DTL.EMPLOYEE_POID, EM.EMPLOYEE_CODE CODE, EM.EMPLOYEE_NAME || ' ' || NVL(EM.EMPLOYEE_NAME2, '') NAME, EMSAL.IBAN_ACCOUNT_NO, BM.BANK_CODE,
      BM.BANK_DESCRIPTION, DTL.NEW_BONUS, EMSAL.BANK_POID
FROM  HR_APPRAISAL_DTL DTL
INNER JOIN HR_APPRAISAL_HDR HDR              ON DTL.TRANSACTION_POID = HDR.TRANSACTION_POID
INNER JOIN HR_EMPLOYEE_MASTER EM           ON DTL.EMPLOYEE_POID    = EM.EMPLOYEE_POID
INNER JOIN HR_EMPLOYEE_SALARY_MASTER EMSAL ON EMSAL.EMPLOYEE_POID  = EM.EMPLOYEE_POID
LEFT JOIN GLOBAL_CUSTOMER_BANK_MASTER BM   ON EMSAL.BANK_POID        = BM.BANK_POID
WHERE HDR.TRANSACTION_POID                                         = $P{TRANSACTION_POID}
  AND NVL( DTL.NEW_BONUS,0)                                       >0
  AND EMSAL.PAYMENT_METHOD                                         = 'BANK'
ORDER BY BM.BANK_CODE, TO_CHAR(LPAD(EM.EMPLOYEE_CODE,4,'0'))]]>
		</queryString>
		<field name="EMPLOYEE_POID" class="java.math.BigDecimal"/>
		<field name="CODE" class="java.lang.String"/>
		<field name="NAME" class="java.lang.String"/>
		<field name="IBAN_ACCOUNT_NO" class="java.lang.String"/>
		<field name="BANK_CODE" class="java.lang.String"/>
		<field name="BANK_DESCRIPTION" class="java.lang.String"/>
		<field name="NEW_BONUS" class="java.math.BigDecimal"/>
		<field name="BANK_POID" class="java.math.BigDecimal"/>
		<variable name="TotalNet" class="java.math.BigDecimal" resetType="Group" resetGroup="Bank" calculation="Sum">
			<variableExpression><![CDATA[$F{NEW_BONUS}]]></variableExpression>
			<initialValueExpression><![CDATA[BigDecimal.valueOf(0)]]></initialValueExpression>
		</variable>
		<variable name="GrandTotal" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{NEW_BONUS}]]></variableExpression>
			<initialValueExpression><![CDATA[BigDecimal.valueOf(0)]]></initialValueExpression>
		</variable>
		<group name="Bank">
			<groupExpression><![CDATA[$F{BANK_CODE}]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="Appraisal_Cash" uuid="d9959274-3634-44cc-8a1c-0b2ce20e49da">
		<parameter name="TRANSACTION_POID" class="java.lang.String">
			<defaultValueExpression><![CDATA[181]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT DTL.EMPLOYEE_POID, EM.EMPLOYEE_CODE CODE, EM.EMPLOYEE_NAME || ' ' || NVL(EM.EMPLOYEE_NAME2,
      '') NAME,  DTL.NEW_BONUS
FROM  HR_APPRAISAL_DTL DTL
INNER JOIN HR_APPRAISAL_HDR HDR              ON DTL.TRANSACTION_POID = HDR.TRANSACTION_POID
INNER JOIN HR_EMPLOYEE_MASTER EM           ON DTL.EMPLOYEE_POID    = EM.EMPLOYEE_POID
INNER JOIN HR_EMPLOYEE_SALARY_MASTER EMSAL ON EMSAL.EMPLOYEE_POID  = EM.EMPLOYEE_POID
WHERE HDR.TRANSACTION_POID                                         = $P{TRANSACTION_POID}
AND NVL( DTL.NEW_BONUS,0) >0 AND EMSAL.PAYMENT_METHOD = 'CASH'
ORDER BY TO_CHAR(LPAD(EM.EMPLOYEE_CODE,4,'0'))]]>
		</queryString>
		<field name="EMPLOYEE_POID" class="java.math.BigDecimal"/>
		<field name="CODE" class="java.lang.String"/>
		<field name="NAME" class="java.lang.String"/>
		<field name="NEW_BONUS" class="java.math.BigDecimal"/>
		<variable name="TotalNet" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{NEW_BONUS}]]></variableExpression>
			<initialValueExpression><![CDATA[BigDecimal.valueOf(0)]]></initialValueExpression>
		</variable>
	</subDataset>
	<parameter name="LOGIN_COMP_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_USER_ID" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["\\\\10.100.1.24\\adflibrary\\deployed\\Reports\\Templates\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_COMP_NAME" class="java.lang.String">
		<defaultValueExpression><![CDATA["AlSharif Group WLL"]]></defaultValueExpression>
	</parameter>
	<parameter name="REPORT_NAME" class="java.lang.String">
		<defaultValueExpression><![CDATA["Report Name"]]></defaultValueExpression>
	</parameter>
	<parameter name="REPORT_FILTERS" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="TRANSACTION_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[0]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT SUM(DTL.NEW_BONUS) AS TOTAL_BONUS
FROM  HR_APPRAISAL_DTL DTL
INNER JOIN HR_APPRAISAL_HDR HDR ON DTL.TRANSACTION_POID = HDR.TRANSACTION_POID
      WHERE HDR.TRANSACTION_POID                                 = $P{TRANSACTION_POID} AND DTL.NEW_BONUS >0]]>
	</queryString>
	<field name="TOTAL_BONUS" class="java.math.BigDecimal"/>
