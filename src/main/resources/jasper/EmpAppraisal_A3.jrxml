			<variableExpression><![CDATA[$F{NEW_BONUS}]]></variableExpression>
			<initialValueExpression><![CDATA[0]]></initialValueExpression>
		</variable>
		<variable name="TotCount" class="java.math.BigDecimal" calculation="Count">
			<variableExpression><![CDATA[$F{DET_ROW_ID}]]></variableExpression>
