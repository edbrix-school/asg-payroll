		</variable>
		<variable name="Dept_NetPercent" class="java.math.BigDecimal">
			<variableExpression><![CDATA[new Double($V{Dept_NetIncrement}.doubleValue() == 0 ? 0 :
($V{Dept_NetIncrement}.doubleValue()/$V{Dept_GrossCurrent}.doubleValue())*100)]]></variableExpression>
		</variable>
		<group name="Dept" isStartNewPage="true">
