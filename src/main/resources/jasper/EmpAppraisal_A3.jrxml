	<subDataset name="SUMMARY" uuid="7d073781-800a-433d-a427-d408f3ef282b">
		<parameter name="DOC_KEY_POID" class="java.lang.String">
			<defaultValueExpression><![CDATA[61]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT DEPT.DEPT_NAME, DEPT.DEPT_CODE, DEPT.SEQNO as DEPT_SEQNO, SUM (DTL.CUR_BASIC_SALARY) CUR_BASIC_SALARY,
      SUM (DTL.CUR_FA_ALW) CUR_FA_ALW, SUM (DTL.CUR_TA_ALW) CUR_TA_ALW, SUM (DTL.CUR_HRA_ALW) CUR_HRA_ALW, SUM (DTL.CUR_FIXOT_ALW) CUR_FIXOT_ALW,
      SUM (DTL.CUR_SPL_ALW) CUR_SPL_ALW, SUM (DTL.CUR_OTH_ALW) CUR_OTH_ALW, SUM (DTL.CUR_AVGOT) CUR_AVGOT, SUM (DTL.CUR_GROSS_PAY) CUR_GROSS_PAY,
      SUM (DTL.NEW_BONUS) NEW_BONUS, SUM (DTL.NEW_BASIC_SALARY) NEW_BASIC_SALARY, SUM (DTL.NEW_FA_ALW) NEW_FA_ALW, SUM (DTL.NEW_TA_ALW) NEW_TA_ALW,
      SUM (DTL.NEW_HRA_ALW) NEW_HRA_ALW, SUM (DTL.NEW_FIXOT_ALW) NEW_FIXOT_ALW, SUM (DTL.NEW_SPL_ALW) NEW_SPL_ALW, SUM (DTL.NEW_OTH_ALW) NEW_OTH_ALW,
      SUM (DTL.NEW_AVGOT) NEW_AVGOT, SUM (DTL.NEW_GROSS_PAY) NEW_GROSS_PAY, SUM(DTL.NET_INCREMENT) NET_INCREMENT, SUM (DTL.ARREARS) ARREARS
FROM HR_APPRAISAL_DTL DTL
INNER JOIN HR_EMPLOYEE_MASTER EM ON EM.EMPLOYEE_POID = DTL.EMPLOYEE_POID
LEFT JOIN HR_DESIGNATION_MASTER DM1 ON DTL.NEW_DESIGNATION_POID = DM1.DESIG_POID AND DTL.DESIGNATION_POID <> DTL.NEW_DESIGNATION_POID
LEFT JOIN HR_DESIGNATION_MASTER DM2 ON DTL.DESIGNATION_POID = DM2.DESIG_POID
LEFT JOIN HR_DEPARTMENT_MASTER DEPT ON EM.DEPARTMENT_POID = DEPT.DEPT_POID
WHERE DTL.TRANSACTION_POID = $P{DOC_KEY_POID}
GROUP BY DEPT.DEPT_NAME, DEPT.DEPT_CODE, DEPT.SEQNO
ORDER BY DEPT.DEPT_CODE]]>
		</queryString>
		<field name="DEPT_NAME" class="java.lang.String"/>
		<field name="DEPT_CODE" class="java.lang.String"/>
		<field name="DEPT_SEQNO" class="java.math.BigDecimal"/>
		<field name="CUR_BASIC_SALARY" class="java.math.BigDecimal"/>
		<field name="CUR_FA_ALW" class="java.math.BigDecimal"/>
		<field name="CUR_TA_ALW" class="java.math.BigDecimal"/>
		<field name="CUR_HRA_ALW" class="java.math.BigDecimal"/>
		<field name="CUR_FIXOT_ALW" class="java.math.BigDecimal"/>
		<field name="CUR_SPL_ALW" class="java.math.BigDecimal"/>
		<field name="CUR_OTH_ALW" class="java.math.BigDecimal"/>
		<field name="CUR_AVGOT" class="java.math.BigDecimal"/>
		<field name="CUR_GROSS_PAY" class="java.math.BigDecimal"/>
		<field name="NEW_BONUS" class="java.math.BigDecimal"/>
		<field name="NEW_BASIC_SALARY" class="java.math.BigDecimal"/>
		<field name="NEW_FA_ALW" class="java.math.BigDecimal"/>
		<field name="NEW_TA_ALW" class="java.math.BigDecimal"/>
		<field name="NEW_HRA_ALW" class="java.math.BigDecimal"/>
		<field name="NEW_FIXOT_ALW" class="java.math.BigDecimal"/>
		<field name="NEW_SPL_ALW" class="java.math.BigDecimal"/>
		<field name="NEW_OTH_ALW" class="java.math.BigDecimal"/>
		<field name="NEW_AVGOT" class="java.math.BigDecimal"/>
		<field name="NEW_GROSS_PAY" class="java.math.BigDecimal"/>
		<field name="NET_INCREMENT" class="java.math.BigDecimal"/>
		<field name="ARREARS" class="java.math.BigDecimal"/>
		<variable name="Cur_TotBasic" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{CUR_BASIC_SALARY}]]></variableExpression>
			<initialValueExpression><![CDATA[0]]></initialValueExpression>
		</variable>
		<variable name="Cur_TotTransport" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{CUR_TA_ALW}]]></variableExpression>
			<initialValueExpression><![CDATA[0]]></initialValueExpression>
		</variable>
		<variable name="Cur_TotFixedAlw" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{CUR_FA_ALW}]]></variableExpression>
			<initialValueExpression><![CDATA[0]]></initialValueExpression>
		</variable>
		<variable name="Cur_TotFixOT" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{CUR_FIXOT_ALW}]]></variableExpression>
			<initialValueExpression><![CDATA[0]]></initialValueExpression>
		</variable>
		<variable name="Cur_TotHRA" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{CUR_HRA_ALW}]]></variableExpression>
			<initialValueExpression><![CDATA[0]]></initialValueExpression>
		</variable>
		<variable name="New_Basic" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{NEW_BASIC_SALARY}]]></variableExpression>
			<initialValueExpression><![CDATA[0]]></initialValueExpression>
		</variable>
		<variable name="New_Transport" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{NEW_TA_ALW}]]></variableExpression>
			<initialValueExpression><![CDATA[0]]></initialValueExpression>
		</variable>
		<variable name="New_FixedAlw" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{NEW_FA_ALW}]]></variableExpression>
			<initialValueExpression><![CDATA[0]]></initialValueExpression>
		</variable>
		<variable name="New_FixOT" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{NEW_FIXOT_ALW}]]></variableExpression>
			<initialValueExpression><![CDATA[0]]></initialValueExpression>
		</variable>
		<variable name="New_HRA" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{NEW_HRA_ALW}]]></variableExpression>
			<initialValueExpression><![CDATA[0]]></initialValueExpression>
		</variable>
		<variable name="TotBonus" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{NEW_BONUS}]]></variableExpression>
			<initialValueExpression><![CDATA[0]]></initialValueExpression>
		</variable>
		<variable name="TotNetDiff" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{NET_INCREMENT}]]></variableExpression>
			<initialValueExpression><![CDATA[0]]></initialValueExpression>
		</variable>
		<variable name="TotalGrossNew" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{NEW_GROSS_PAY}]]></variableExpression>
			<initialValueExpression><![CDATA[0]]></initialValueExpression>
		</variable>
		<variable name="TotalGrossCurrent" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{CUR_GROSS_PAY}]]></variableExpression>
			<initialValueExpression><![CDATA[0]]></initialValueExpression>
		</variable>
		<variable name="TotalNetPercent" class="java.math.BigDecimal">
			<variableExpression><![CDATA[new Double($V{TotNetDiff}.doubleValue() == 0 ? 0 :
($V{TotNetDiff}.doubleValue()/$V{TotalGrossCurrent}.doubleValue())*100)]]></variableExpression>
		</variable>
		<variable name="NetPercent" class="java.math.BigDecimal">
			<variableExpression><![CDATA[new Double($F{NET_INCREMENT}.doubleValue() == 0 ? 0 :
($F{NET_INCREMENT}.doubleValue()/$F{CUR_GROSS_PAY}.doubleValue())*100)]]></variableExpression>
		</variable>
	</subDataset>
	<parameter name="LOGIN_GROUP_POID" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_COMP_POID" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
