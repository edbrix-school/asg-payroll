	<subDataset name="APPR_DTL" uuid="b4344b76-4874-4659-b115-e7a8fa073955">
		<parameter name="DOC_KEY_POID" class="java.lang.String">
			<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT DTL.TRANSACTION_POID,DTL.DET_ROW_ID,DTL.JOIN_DATE, EM.EMPLOYEE_CODE, EMPLOYEE_NAME || ' ' || EMPLOYEE_NAME2 AS EMPLOYEE_NAME, GET_CR_NAME(
      EM.CR_POID)EMP_REG_COMP,EM.ACTIVE, EM.EMP_GL_POID, DM2.DESIGNATION_NAME as CUR_DESIGNATION, DM1.DESIGNATION_NAME as NEW_DESIGNATION, DTL.CUR_NO_OF_TICKETS,
      DTL.CUR_AIR_ENTITLE, DTL.CUR_BONUS,DTL.CUR_INCREMENT, DTL.CUR_BASIC_SALARY,DTL.CUR_FA_ALW,DTL.CUR_TA_ALW,DTL.CUR_HRA_ALW,DTL.CUR_FIXOT_ALW,
      DTL.CUR_SPL_ALW, DTL.CUR_OTH_ALW,DTL.CUR_AVGOT,DTL.CUR_GROSS_PAY,
      CASE
            WHEN DTL.NEW_NO_OF_TICKETS IS NOT NULL THEN DTL.NEW_NO_OF_TICKETS || ' ticket in ' || DTL.NEW_TICKET_PERIOD || ' Yrs' ELSE ''
      END AS TICKET_PERIOD, DTL.NEW_BONUS,DTL.NEW_INCREMENT_PER,DTL.NEW_BASIC_SALARY, DTL.NEW_FA_ALW,DTL.NEW_TA_ALW,DTL.NEW_HRA_ALW,
      DTL.NEW_FIXOT_ALW,DTL.NEW_SPL_ALW,DTL.NEW_OTH_ALW,DTL.NEW_AVGOT,DTL.NEW_GROSS_PAY, DTL.NET_INCREMENT, DTL.ARREARS, DTL.NEW_BONUS_PER,
      DEPT.DEPT_NAME, DEPT.DEPT_CODE, DEPT.SEQNO as DEPT_SEQNO, DTL.LAST_PROMOTION_DATE
FROM  HR_APPRAISAL_DTL DTL
INNER JOIN HR_EMPLOYEE_MASTER EM ON EM.EMPLOYEE_POID=DTL.EMPLOYEE_POID
LEFT JOIN HR_DESIGNATION_MASTER DM1 ON DTL.NEW_DESIGNATION_POID = DM1.DESIG_POID AND DTL.DESIGNATION_POID <> DTL.NEW_DESIGNATION_POID
LEFT JOIN HR_DESIGNATION_MASTER DM2 ON DTL.DESIGNATION_POID = DM2.DESIG_POID
LEFT JOIN HR_DEPARTMENT_MASTER DEPT ON EM.DEPARTMENT_POID = DEPT.DEPT_POID
WHERE DTL.TRANSACTION_POID                          =  $P{DOC_KEY_POID}
ORDER BY DEPT.DEPT_CODE, TO_NUMBER(EM.EMPLOYEE_CODE)]]>
		</queryString>
		<field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
		<field name="DET_ROW_ID" class="java.math.BigDecimal"/>
		<field name="JOIN_DATE" class="java.sql.Timestamp"/>
		<field name="EMPLOYEE_CODE" class="java.lang.String"/>
