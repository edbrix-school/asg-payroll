	<parameter name="LOGIN_USER_POID" class="java.lang.String" isForPrompting="false"/>
	<parameter name="DOC_ID" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["000-000"]]></defaultValueExpression>
	</parameter>
	<parameter name="DOC_KEY_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["\\\\shippingbahrain.com\\data\\ERP_REPORTS\\Reports\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT HDR.TRANSACTION_POID, HDR.TRANSACTION_DATE, HDR.COMPANY_POID, HDR.DOC_REF, HDR.PERIOD_FROM, HDR.DESCRIPTION, CM.COMPANY_NAME
FROM  HR_APPRAISAL_HDR HDR
INNER JOIN GLOBAL_COMPANY_MASTER CM ON HDR.COMPANY_POID = CM.COMPANY_POID
WHERE TRANSACTION_POID = $P{DOC_KEY_POID}]]>
	</queryString>
	<field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
	<field name="TRANSACTION_DATE" class="java.sql.Timestamp"/>
	<field name="COMPANY_POID" class="java.math.BigDecimal"/>
	<field name="DOC_REF" class="java.lang.String"/>
	<field name="PERIOD_FROM" class="java.sql.Timestamp"/>
	<field name="DESCRIPTION" class="java.lang.String"/>
	<field name="COMPANY_NAME" class="java.lang.String"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="46" splitType="Stretch">
			<textField>
				<reportElement x="2" y="0" width="575" height="46" uuid="2575b530-5b01-414a-a446-e490ddf22568"/>
				<textElement verticalAlignment="Middle">
					<font size="24"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{COMPANY_NAME}]]></textFieldExpression>
