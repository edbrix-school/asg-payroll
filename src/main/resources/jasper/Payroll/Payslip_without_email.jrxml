    <subDataset name="LoanBreakup" uuid="6251cf2b-f1d9-4031-a6b3-8b7f484d38a5">
        <parameter name="EMPLOYEE_POID" class="java.math.BigDecimal">
            <defaultValueExpression><![CDATA[]]></defaultValueExpression>
        </parameter>
        <parameter name="TRANSACTION_POID" class="java.lang.String">
            <defaultValueExpression><![CDATA[]]></defaultValueExpression>
        </parameter>
        <queryString>
            <![CDATA[SELECT REF_NO, RECUR_AMOUNT
FROM HR_PAYROLL_RECURRING_DTL
WHERE TRANSACTION_POID = $P{TRANSACTION_POID}
AND EMPLOYEE_POID = $P{EMPLOYEE_POID}]]>
        </queryString>
        <field name="REF_NO" class="java.lang.String"/>
        <field name="RECUR_AMOUNT" class="java.math.BigDecimal"/>
    </subDataset>
    <parameter name="LOGIN_GROUP_POID" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA[1]]></defaultValueExpression>
    </parameter>
    <parameter name="LOGIN_COMP_POID" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA[1]]></defaultValueExpression>
    </parameter>
    <parameter name="LOGIN_USER_POID" class="java.lang.String" isForPrompting="false"/>
    <parameter name="DOC_ID" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["000-000"]]></defaultValueExpression>
    </parameter>
    <parameter name="DOC_KEY_POID" class="java.lang.String"/>
    <parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["\\\\shippingbahrain.com\\data\\ERP_REPORTS\\Reports\\"]]></defaultValueExpression>
    </parameter>
    <parameter name="SUB_HEADER" class="net.sf.jasperreports.engine.JasperReport"/>
    <queryString>
        <![CDATA[SELECT DTL.EMPLOYEE_POID, EM.EMPLOYEE_CODE, EMPLOYEE_NAME || ' ' || EMPLOYEE_NAME2 AS EMPLOYEE_NAME, DTL.BASIC_SALARY, DTL.BASIC_SALARY_PAYABLE,
      DTL.WORKED_DAYS, DTL.ABSENT_AMOUNT, DTL.OT1_HRS, DTL.OT1_AMT, DTL.OT2_HRS, DTL.OT2_AMT, DTL.SHORT_HRS, DTL.SHORT_HRS_AMOUNT, DTL.MEDICAL_DAYS,
      DTL.FIXED_ALLOWANCE, DTL.FIXED_OT, DTL.HRA_ALLOWANCE, DTL.TRAVEL_ALLOWANCE, DTL.COMMUNICATION_ALLOWANCE, DTL.TRANSPORT_ALLOWANCE,
      DTL.SPECIAL_ALLOWANCE, DTL.GOSI_DEDUCTION * -1 as GOSI_DEDUCTION, DTL.LOAN_DEDUCTION * -1 as LOAN_DEDUCTION,
      DTL.PHONE_DEDUCTION, DTL.MEDICAL_INSURANCE, DTL.ARREARS,
      DTL.RECURRING_DEDUCTION, DTL.TOT_ALLOWANCE, DTL.GROSS_SALARY, DTL.TOT_DEDUCTIONS, DTL.NET_SALARY, BM.BANK_CODE, DTL.ACCOUNT_NO,
      HDR.PAYROLL_MONTH,FN_AMOUNT_IN_WORDS_COMMON(DTL.NET_SALARY, 'BHD') AMOUNT_IN_WORDS,
      CASE
            WHEN DTL.WORKED_DAYS = 30 THEN NULL
            ELSE CAST(TO_CHAR(LAST_DAY(PAYROLL_MONTH),'dd') AS INT) - DTL.WORKED_DAYS
      END AS ABSENT_DAYS,
      CASE
            WHEN PAYROLL_JV_DOC_POID IS NULL THEN PRODUCTION.FUNC_GL_LEDGER_BALANCE(NULL, EMP_GL_POID, NULL) - LOAN_DEDUCTION
            ELSE PRODUCTION.FUNC_GL_LEDGER_BALANCE(NULL, EMP_GL_POID, NULL)
      END AS LOAN_BALANCE
FROM  HR_PAYROLL_DTL DTL
INNER JOIN HR_PAYROLL_HDR HDR    ON DTL.TRANSACTION_POID = HDR.TRANSACTION_POID
INNER JOIN HR_EMPLOYEE_MASTER EM ON DTL.EMPLOYEE_POID    = EM.EMPLOYEE_POID
LEFT JOIN PRODUCTION.GLOBAL_CUSTOMER_BANK_MASTER BM ON DTL.BANK_POID = BM.BANK_POID
WHERE HDR.TRANSACTION_POID = $P{DOC_KEY_POID}
AND DTL.NET_SALARY > 0
AND ( NVL(EM.PERSONAL_EMAIL, EM.BUSINESS_EMAIL) IS NULL OR EM.DATE_OF_BIRTH IS NULL)]]>
    </queryString>
