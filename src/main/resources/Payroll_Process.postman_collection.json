{
	"info": {
		"name": "Payroll Process API",
		"description": "API collection for HR Payroll Process module — CRUD, actions, and print endpoints.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{AccessToken}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8088/payroll/api",
			"type": "string"
		},
		{
			"key": "AccessToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "documentId",
			"value": "PAY-001",
			"type": "string"
		},
		{
			"key": "transactionPoid",
			"value": "1",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Payroll CRUD",
			"item": [
				{
					"name": "List Payrolls",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "X-Document-Id", "value": "{{documentId}}" },
							{ "key": "X-Action-Requested", "value": "VIEW" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"operator\": \"AND\",\n  \"isDeleted\": \"N\",\n  \"filters\": []\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/v1/payroll-process/list?page=0&size=10&periodFrom=&periodTo=",
							"host": ["{{baseUrl}}"],
							"path": ["v1", "payroll-process", "list"],
							"query": [
								{ "key": "page", "value": "0" },
								{ "key": "size", "value": "10" },
								{ "key": "periodFrom", "value": "", "disabled": true },
								{ "key": "periodTo", "value": "", "disabled": true }
							]
						}
					}
				},
				{
					"name": "Get Payroll By ID",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "X-Document-Id", "value": "{{documentId}}" },
							{ "key": "X-Action-Requested", "value": "VIEW" }
						],
						"url": "{{baseUrl}}/v1/payroll-process/{{transactionPoid}}"
					}
				},
				{
					"name": "Create Payroll",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "X-Document-Id", "value": "{{documentId}}" },
							{ "key": "X-Action-Requested", "value": "CREATE" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"transactionDate\": \"2024-01-31\",\n  \"attendTranPoid\": 1001,\n  \"payrollMonth\": \"2024-01-31\",\n  \"attendancePeriodDesc\": \"January 2024\",\n  \"bankTransferValueDate\": \"2024-02-05\",\n  \"suppressArrearsValidation\": \"N\",\n  \"variableDetails\": [\n    {\n      \"actionType\": \"ISCREATED\",\n      \"employeePoid\": 2001,\n      \"allowanceDeductionPoid\": 3001,\n      \"amount\": 500.000,\n      \"remarks\": \"Monthly variable allowance\"\n    }\n  ],\n  \"recurringDetails\": [\n    {\n      \"actionType\": \"ISCREATED\",\n      \"employeePoid\": 2001,\n      \"refNo\": \"LOAN-001\",\n      \"balAmt\": 5000.000,\n      \"recurAmount\": 500.000,\n      \"remarks\": \"Monthly loan deduction\"\n    }\n  ]\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": "{{baseUrl}}/v1/payroll-process"
					}
				},
				{
					"name": "Update Payroll",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "X-Document-Id", "value": "{{documentId}}" },
							{ "key": "X-Action-Requested", "value": "EDIT" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"transactionDate\": \"2024-01-31\",\n  \"attendTranPoid\": 1001,\n  \"payrollMonth\": \"2024-01-31\",\n  \"attendancePeriodDesc\": \"January 2024\",\n  \"bankTransferValueDate\": \"2024-02-05\",\n  \"suppressArrearsValidation\": \"N\",\n  \"variableDetails\": [],\n  \"recurringDetails\": []\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": "{{baseUrl}}/v1/payroll-process/{{transactionPoid}}"
					}
				},
				{
					"name": "Delete Payroll",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "X-Document-Id", "value": "{{documentId}}" },
							{ "key": "X-Action-Requested", "value": "DELETE" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"reason\": \"Duplicate entry\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": "{{baseUrl}}/v1/payroll-process/{{transactionPoid}}"
					}
				}
			]
		},
		{
			"name": "Payroll Actions",
			"item": [
				{
					"name": "Process Payroll",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "X-Document-Id", "value": "{{documentId}}" },
							{ "key": "X-Action-Requested", "value": "EDIT" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"attendTranPoid\": 1001,\n  \"payrollMonth\": \"2024-01-31\",\n  \"suppressArrearsValidation\": false\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": "{{baseUrl}}/v1/payroll-process/{{transactionPoid}}/process-payroll"
					}
				},
				{
					"name": "Process Provision",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "X-Document-Id", "value": "{{documentId}}" },
							{ "key": "X-Action-Requested", "value": "EDIT" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"attendTranPoid\": 1001,\n  \"payrollMonth\": \"2024-01-31\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": "{{baseUrl}}/v1/payroll-process/{{transactionPoid}}/process-provision"
					}
				},
				{
					"name": "Revert Payroll",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "X-Document-Id", "value": "{{documentId}}" },
							{ "key": "X-Action-Requested", "value": "EDIT" }
						],
						"url": "{{baseUrl}}/v1/payroll-process/{{transactionPoid}}/revert"
					}
				},
				{
					"name": "Load Variables",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "X-Document-Id", "value": "{{documentId}}" },
							{ "key": "X-Action-Requested", "value": "EDIT" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"payrollMonth\": \"2024-01-31\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": "{{baseUrl}}/v1/payroll-process/{{transactionPoid}}/load-variables"
					}
				},
				{
					"name": "Load Loans & Advances",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "X-Document-Id", "value": "{{documentId}}" },
							{ "key": "X-Action-Requested", "value": "EDIT" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"payrollMonth\": \"2024-01-31\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": "{{baseUrl}}/v1/payroll-process/{{transactionPoid}}/load-loans-advances"
					}
				},
				{
					"name": "Create JV",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "X-Document-Id", "value": "{{documentId}}" },
							{ "key": "X-Action-Requested", "value": "EDIT" }
						],
						"url": "{{baseUrl}}/v1/payroll-process/{{transactionPoid}}/create-jv"
					}
				},
				{
					"name": "Generate Bank File",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "X-Document-Id", "value": "{{documentId}}" },
							{ "key": "X-Action-Requested", "value": "EDIT" }
						],
						"url": "{{baseUrl}}/v1/payroll-process/{{transactionPoid}}/bank-file"
					}
				},
				{
					"name": "HSBC API Transfer",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "X-Document-Id", "value": "{{documentId}}" },
							{ "key": "X-Action-Requested", "value": "EDIT" }
						],
						"url": "{{baseUrl}}/v1/payroll-process/{{transactionPoid}}/hsbc-api-transfer"
					}
				},
				{
					"name": "Sync HR Data",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "X-Document-Id", "value": "{{documentId}}" },
							{ "key": "X-Action-Requested", "value": "EDIT" }
						],
						"url": "{{baseUrl}}/v1/payroll-process/sync-hr-data"
					}
				},
				{
					"name": "Send Email (Schedule Payslip)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "X-Document-Id", "value": "{{documentId}}" },
							{ "key": "X-Action-Requested", "value": "EDIT" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"scheduleOn\": \"2024-02-01T09:00:00\",\n  \"resend\": \"N\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": "{{baseUrl}}/v1/payroll-process/{{transactionPoid}}/send-email"
					}
				}
			]
		},
		{
			"name": "Print",
			"item": [
				{
					"name": "Print Payslip (PDF)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "X-Document-Id", "value": "{{documentId}}" },
							{ "key": "X-Action-Requested", "value": "PRINT" }
						],
						"url": "{{baseUrl}}/v1/payroll-process/print/{{transactionPoid}}/payslip"
					}
				},
				{
					"name": "Print Preview (PDF)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "X-Document-Id", "value": "{{documentId}}" },
							{ "key": "X-Action-Requested", "value": "PRINT" }
						],
						"url": "{{baseUrl}}/v1/payroll-process/print/{{transactionPoid}}/preview"
					}
				}
			]
		}
	]
}
