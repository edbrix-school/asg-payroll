  "item": [
    {
      "name": "Create Payroll Variable",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"transactionDate\": \"2024-01-15\",\n  \"employeePoid\": 101,\n  \"amount\": 250.000,\n  \"payrollMonth\": \"2024-01-01\",\n  \"remarks\": \"Monthly allowance for January\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/payroll-variables",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "payroll-variables"]
        },
        "description": "Creates a new Payroll Variable / Arrears Entry. Company POID and Group POID are automatically taken from the authenticated user context. Required fields: employeePoid, amount (negatives allowed), payrollMonth, remarks."
      },
      "response": [
        {
          "name": "Success",
          "status": "OK",
          "code": 200,
          "body": "{\n  \"status\": \"success\",\n  \"message\": \"Payroll Variable created successfully\",\n  \"result\": {\n    \"data\": {\n      \"transactionPoid\": 1,\n      \"companyPoid\": 1,\n      \"groupPoid\": 1,\n      \"transactionDate\": \"2024-01-15\",\n      \"docRef\": \"VAR-000001\",\n      \"employeePoid\": 101,\n      \"employeeDet\": {\n        \"poid\": 101,\n        \"code\": \"EMP001\",\n        \"label\": \"John Doe\",\n        \"value\": 101,\n        \"description\": \"John Doe\"\n      },\n      \"amount\": 250.000,\n      \"payrollMonth\": \"2024-01-01\",\n      \"remarks\": \"Monthly allowance for January\",\n      \"createdBy\": \"admin\",\n      \"createdDate\": \"2024-01-15T10:00:00\"\n    }\n  }\n}"
        }
      ]
    },
    {
